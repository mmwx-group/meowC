<?xml version="1.0" encoding="utf-8"?>
<!-- MeowX：桌面小组件（中号 4×2），与 iOS 的中号同一套布局；数据与点击由 meowx/MeowXWidget.kt 填。
     这里写的示例文字也是小组件选择器里的预览（previewLayout）。只用 RemoteViews 支持的控件。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meowx_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meowx_w_bg_on"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/meowx_w_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/meowx_w_dot"
                    android:tint="@color/meowx_w_good" />

                <TextView
                    android:id="@+id/meowx_w_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="妙妙屋X"
                    android:textColor="@color/meowx_w_good"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/meowx_w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="已连接"
                android:textColor="@color/meowx_w_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/meowx_w_uptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format="已运行 %s"
                android:maxLines="1"
                android:textColor="@color/meowx_w_t2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/meowx_w_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="轻点电源键连接"
                android:textColor="@color/meowx_w_idle_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/meowx_w_power"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/meowx_w_power_on"
            android:contentDescription="连接 / 断开">

            <ImageView
                android:id="@+id/meowx_w_power_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/meowx_w_ic_power"
                android:tint="@color/meowx_w_on_power_on" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/meowx_w_card"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="本次"
            android:textColor="@color/meowx_w_t2"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/meowx_w_down_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓"
            android:textColor="@color/meowx_w_vio"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meowx_w_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="12dp"
            android:maxLines="1"
            android:text="1.2 GB"
            android:textColor="@color/meowx_w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meowx_w_up_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↑"
            android:textColor="@color/meowx_w_rose"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meowx_w_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:maxLines="1"
            android:text="35 MB"
            android:textColor="@color/meowx_w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/meowx_w_usage_box"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meowx_w_usage_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:text="128.4 / 500 GB"
                android:textColor="@color/meowx_w_t2"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/meowx_w_usage_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="257"
                android:progressDrawable="@drawable/meowx_w_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/meowx_w_no_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="未导入订阅"
            android:textColor="@color/meowx_w_t2"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/meowx_w_seg_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/meowx_w_mode_rule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/meowx_w_seg_on"
            android:gravity="center"
            android:text="规则"
            android:textColor="@color/meowx_w_on_strong"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meowx_w_mode_global"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="全局"
            android:textColor="@color/meowx_w_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/meowx_w_mode_direct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="直连"
            android:textColor="@color/meowx_w_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
