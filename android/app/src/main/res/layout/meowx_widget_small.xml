<?xml version="1.0" encoding="utf-8"?>
<!-- MeowX：桌面小组件（小号 2×2），与 iOS 的小号同一套布局；数据与点击由 meowx/MeowXWidget.kt 填。
     这里写的示例文字也是小组件选择器里的预览（previewLayout）。只用 RemoteViews 支持的控件。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meowx_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/meowx_w_bg_on"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/meowx_w_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/meowx_w_dot"
                    android:tint="@color/meowx_w_good" />

                <TextView
                    android:id="@+id/meowx_w_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="妙妙屋X"
                    android:textColor="@color/meowx_w_good"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/meowx_w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="已连接"
                android:textColor="@color/meowx_w_ink"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/meowx_w_power"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/meowx_w_power_on"
            android:contentDescription="连接 / 断开">

            <ImageView
                android:id="@+id/meowx_w_power_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/meowx_w_ic_power"
                android:tint="@color/meowx_w_on_power_on" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/meowx_w_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="11dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本次流量"
                android:textColor="@color/meowx_w_t2"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/meowx_w_down_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓"
                    android:textColor="@color/meowx_w_vio"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/meowx_w_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:text="1.2 GB"
                    android:textColor="@color/meowx_w_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/meowx_w_up_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑"
                    android:textColor="@color/meowx_w_rose"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/meowx_w_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:text="35 MB"
                    android:textColor="@color/meowx_w_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/meowx_w_ring_box"
            android:layout_width="38dp"
            android:layout_height="38dp">

            <ProgressBar
                android:id="@+id/meowx_w_ring"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="26"
                android:progressDrawable="@drawable/meowx_w_ring" />

            <TextView
                android:id="@+id/meowx_w_ring_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="26%"
                android:textColor="@color/meowx_w_ink"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/meowx_w_seg_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/meowx_w_mode_rule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/meowx_w_seg_on"
            android:gravity="center"
            android:text="规则"
            android:textColor="@color/meowx_w_on_strong"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meowx_w_mode_global"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="全局"
            android:textColor="@color/meowx_w_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/meowx_w_mode_direct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="直连"
            android:textColor="@color/meowx_w_ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
